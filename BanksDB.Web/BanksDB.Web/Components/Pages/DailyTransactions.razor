@page "/transactions/{AccountId:int}/{TransactionDate:datetime}"
@using BanksDB.BLL.Interfaces
@using BanksDB.BLL.Services
@using BanksDB.Core.Entities
@inject ITransactionService TransactionService
@inject NavigationManager Navigation
@inject AuthenticationService AuthenticationService

<PageTitle>Транзакции за день</PageTitle>

@if (shouldRedirect)
{
    <div style="text-align: center; padding: 3rem;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Загрузка...</span>
        </div>
        <p class="mt-2">Перенаправление на страницу входа...</p>
    </div>
}
else if (!isInitialized)
{
    <div style="text-align: center; padding: 3rem;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Загрузка...</span>
        </div>
        <p class="mt-2">Инициализация...</p>
    </div>
}
else
{
    <div class="transactions-container">
        <div class="page-header">
            <div class="header-content">
                <button @onclick="GoBack" class="btn-back">
                    ← Назад к отчету
                </button>
                <h3>📋 Операции за @TransactionDate.ToString("dd.MM.yyyy")</h3>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="loading-spinner">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Загрузка...</span>
                </div>
            </div>
        }
        else if (transactions.Any())
        {
            <div class="transactions-summary">
                <div class="summary-cards">
                    <div class="summary-card income-card">
                        <div class="card-label">Приход</div>
                        <div class="card-amount">@transactions.Where(t => t.TransactionType == "Приход").Sum(t => t.Amount).ToString("C")</div>
                    </div>
                    <div class="summary-card expense-card">
                        <div class="card-label">Расход</div>
                        <div class="card-amount">@transactions.Where(t => t.TransactionType == "Расход").Sum(t => t.Amount).ToString("C")</div>
                    </div>
                    <div class="summary-card total-card">
                        <div class="card-label">Итого</div>
                        <div class="card-amount @GetNetAmountClass()">
                            @GetNetAmount().ToString("C")
                        </div>
                    </div>
                </div>
            </div>

            <div class="transactions-table">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Время</th>
                                <th>Номер</th>
                                <th>Тип</th>
                                <th>Сумма</th>
                                <th>Контрагент</th>
                                <th>Назначение платежа</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var transaction in transactions)
                            {
                                <tr>
                                    <td>@transaction.TransactionDate.ToString("HH:mm")</td>
                                    <td>
                                        <strong>@transaction.DocumentNumber</strong>
                                    </td>
                                    <td>
                                        <span class="badge @(transaction.TransactionType == "Приход" ? "bg-success" : "bg-danger")">
                                            @transaction.TransactionType
                                        </span>
                                    </td>
                                    <td class="fw-bold @(transaction.TransactionType == "Приход" ? "text-success" : "text-danger")">
                                        @transaction.Amount.ToString("N2") руб.
                                    </td>
                                    <td>
                                        <div class="counterparty-info">
                                            <div class="counterparty-name">@transaction.CounterpartyName</div>
                                            @if (!string.IsNullOrEmpty(transaction.CounterpartyInn))
                                            {
                                                <div class="counterparty-inn">ИНН: @transaction.CounterpartyInn</div>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(transaction.Description))
                                        {
                                            <div class="description-text" title="@transaction.Description">
                                                @transaction.Description
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        <button @onclick="() => ShowTransactionDetails(transaction)" 
                                                class="btn btn-sm btn-outline-primary btn-details"
                                                title="Подробнее">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div>📊</div>
                <h6>Транзакции не найдены</h6>
                <p>На @TransactionDate.ToString("dd.MM.yyyy") операций не совершалось</p>
            </div>
        }
    </div>

    <!-- Модальное окно для деталей транзакции -->
    @if (showDetailsModal && selectedTransaction != null)
    {
        <div class="modal-overlay show">
            <div class="modal-content show">
                <div class="modal-header">
                    <h5 class="modal-title">
                        Детали операции № @selectedTransaction.DocumentNumber
                        <span class="badge @(selectedTransaction.TransactionType == "Приход" ? "bg-success" : "bg-danger") ms-2">
                            @selectedTransaction.TransactionType
                        </span>
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseDetailsModal">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Основная информация</h6>
                            <table class="table table-sm table-borderless">
                                <tr>
                                    <td class="fw-bold">Дата операции:</td>
                                    <td>@selectedTransaction.TransactionDate.ToString("dd.MM.yyyy HH:mm")</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Сумма:</td>
                                    <td class="fw-bold @(selectedTransaction.TransactionType == "Приход" ? "text-success" : "text-danger")">
                                        @selectedTransaction.Amount.ToString("N2") руб.
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Тип операции:</td>
                                    <td>@selectedTransaction.TransactionType</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Дата списания:</td>
                                    <td>@(selectedTransaction.TransactionDate != default ? selectedTransaction.TransactionDate.ToString("dd.MM.yyyy") : "-")</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Дата поступления:</td>
                                    <td>@(selectedTransaction.TransactionDate != default ? selectedTransaction.TransactionDate.ToString("dd.MM.yyyy") : "-")</td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <h6>Реквизиты</h6>
                            <table class="table table-sm table-borderless">
                                <tr>
                                    <td class="fw-bold">Номер документа:</td>
                                    <td>@selectedTransaction.DocumentNumber</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Дата создания:</td>
                                    <td>@selectedTransaction.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Плательщик -->
                    <div class="mt-4">
                        <h6>Плательщик</h6>
                        <div class="card card-body bg-light">
                            <table class="table table-sm table-borderless mb-0">
                                <tr>
                                    <td class="fw-bold" style="width: 120px;">Наименование:</td>
                                    <td>@selectedTransaction.PayerName</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">ИНН:</td>
                                    <td>@selectedTransaction.PayerInn</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Счет:</td>
                                    <td>@selectedTransaction.PayerAccount</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Получатель -->
                    <div class="mt-3">
                        <h6>Получатель</h6>
                        <div class="card card-body bg-light">
                            <table class="table table-sm table-borderless mb-0">
                                <tr>
                                    <td class="fw-bold" style="width: 120px;">Наименование:</td>
                                    <td>@selectedTransaction.CounterpartyName</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">ИНН:</td>
                                    <td>@selectedTransaction.CounterpartyInn</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Счет:</td>
                                    <td>@selectedTransaction.CounterpartyAccount</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Назначение платежа -->
                    @if (!string.IsNullOrEmpty(selectedTransaction.Description))
                    {
                        <div class="mt-3">
                            <h6>Назначение платежа</h6>
                            <div class="card card-body bg-light">
                                <p class="mb-0">@selectedTransaction.Description</p>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDetailsModal">Закрыть</button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int AccountId { get; set; }
    [Parameter] public DateTime TransactionDate { get; set; }

    private List<Transaction> transactions = new();
    private bool isLoading = true;
    private bool showDetailsModal = false;
    private Transaction? selectedTransaction = null;
    private bool isInitialized = false;
    private bool shouldRedirect = false;
    private bool isAuthChecked = false;

    protected override void OnInitialized()
    {
        AuthenticationService.OnAuthenticationStateChanged += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // if (firstRender)
        // {
        //     try
        //     {
        //         await AuthenticationService.InitializeAsync();
        //         if (!AuthenticationService.IsAuthenticated)
        //         {
        //             shouldRedirect = true;
        //             StateHasChanged();                    

        //             await Task.Delay(2000);
        //             Navigation.NavigateTo("/login", true);
        //             return;
        //         }
        //         else
        //         {
        //             await LoadTransactions();
        //             isInitialized = true;
        //             StateHasChanged();
        //         }
        //     }
        //     catch (Exception ex)
        //     {
        //         Console.WriteLine($"Ошибка инициализации: {ex}");                
        //         shouldRedirect = true;
        //         StateHasChanged();
        //         await Task.Delay(2000);
        //         Navigation.NavigateTo("/login", true);
        //     }
        // }
        if (firstRender && !isAuthChecked)
        {
            await CheckAuthenticationAndInitialize();
        }
    }

    private async Task CheckAuthenticationAndInitialize()
    {
        try
        {
            await AuthenticationService.InitializeAsync();
            if (!AuthenticationService.IsAuthenticated)
            {
                shouldRedirect = true;
                StateHasChanged();                

                await Task.Delay(2000);
                Navigation.NavigateTo("/login", true);
                return;
            }
            else
            {
                isAuthChecked = true;
                isInitialized = true;
                await LoadTransactions();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка инициализации: {ex}");
            shouldRedirect = true;
            StateHasChanged();
            await Task.Delay(2000);
            Navigation.NavigateTo("/login", true);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (isInitialized && AuthenticationService.IsAuthenticated)
        {
            await LoadTransactions();
        }
    }

    private async Task LoadTransactions()
    {
        if (!AuthenticationService.IsAuthenticated) return;

        isLoading = true;
        StateHasChanged();

        try
        {
            await Task.Delay(100);
            transactions = await TransactionService.GetTransactionsByAccountAndDateAsync(AccountId, TransactionDate);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки транзакций: {ex.Message}");
            transactions = new List<Transaction>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ShowTransactionDetails(Transaction transaction)
    {
        if (!AuthenticationService.IsAuthenticated) return;
        
        selectedTransaction = transaction;
        showDetailsModal = true;
        StateHasChanged();
    }

    private void CloseDetailsModal()
    {
        showDetailsModal = false;
        selectedTransaction = null;
        StateHasChanged();
    }

    private void GoBack()
    {
        Navigation.NavigateTo($"/account/{AccountId}");
    }

    private decimal GetNetAmount()
    {
        var income = transactions.Where(t => t.TransactionType == "Приход").Sum(t => t.Amount);
        var expense = transactions.Where(t => t.TransactionType == "Расход").Sum(t => t.Amount);
        return income - expense;
    }

    private string GetNetAmountClass()
    {
        return GetNetAmount() >= 0 ? "text-success" : "text-danger";
    }

    private async void OnAuthenticationChanged()
    {
        if (!AuthenticationService.IsAuthenticated && isInitialized)
        {        
        Navigation.NavigateTo("/login", true);
        }
        else
        {
        await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        AuthenticationService.OnAuthenticationStateChanged -= OnAuthenticationChanged;
    }

    // public void Dispose()
    // {
    //     AuthenticationService.OnAuthenticationStateChanged -= StateHasChanged;
    // }
}
