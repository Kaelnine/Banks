@page "/"
@page "/index"
@using AutoMapper
@using BanksDB.BLL.Interfaces
@using BanksDB.BLL.Services
@using BanksDB.Core.Dtos
@using BanksDB.Core.Models.OutputModels
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore.Metadata.Internal
@using Microsoft.AspNetCore.Components
@inject IAccountService AccountService
@inject NavigationManager Navigation
@inject IMapper Mapper
@inject IAuthenticationService AuthenticationService
@implements IDisposable


@* @if (!AuthenticationService.IsAuthenticated)
{
	<div style="text-align: center; padding: 3rem;">
		<div class="spinner-border text-primary" role="status">
			<span class="visually-hidden">Загрузка...</span>
		</div>
		<p class="mt-2">Проверка авторизации...</p>
	</div>
	
} *@
@if (shouldRedirect)
{
    <div style="text-align: center; padding: 3rem;">
        <p>Перенаправление на страницу входа...</p>
    </div>
    
    @code {
        protected override void OnAfterRender(bool firstRender)
        {
            if (shouldRedirect)
            {
                Navigation.NavigateTo("/login");
            }
        }
    }
}
else if (!isInitialized)
{
    <div style="text-align: center; padding: 3rem;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Загрузка...</span>
        </div>
        <p class="mt-2">Инициализация...</p>
    </div>
}
else
{
	<!DOCTYPE html>
	<html>
	<head>
		<link href="css/site.css" rel="stylesheet" />
	</head>
	<body>
		<div class="page-container">
		<!-- Блок с пользователем и кнопкой выхода -->		
			<div class="user-header">
			
			<div class="user-info">
				<span>
					@* 👤 @AuthenticationService.CurrentUser.FullName *@
					👤 @(AuthenticationService.CurrentUser?.FullName ?? "Пользователь")
					@* <small>(@AuthenticationService.CurrentUser.RoleDisplayName)</small> *@
					<small>(@(AuthenticationService.CurrentUser?.RoleDisplayName ?? "Неизвестно"))</small>
				</span>
					<button @onclick="Logout" class="btn-login btn-logout">
						Выйти
					</button>
			</div>
				
				
		</div>
		
		</div>
		<!-- Панель управления для бухгалтера -->
		@* @if (AuthenticationService.CurrentUser.Role == "Accountant") *@
		@if (AuthenticationService.CurrentUser?.Role == "Accountant")
		{
			<div class="page-container">
				<div class="admin-panel">
					<h5 style="margin-top: 0;">📊 Панель управления бухгалтера</h5>
					<div class="admin-buttons">						
						<button class="btn-login" @onclick="ShowOrganizationModal">
							🏢 Организации
						</button>
						<button class="btn-login" @onclick="ShowAccountModal">
							💳 Счета
						</button>
						<button class="btn-login" @onclick="ShowBankModal">
							🏦 Банки
						</button>
					</div>
				</div>
			</div>
			
		}
		<div class="page-container">
			<h3>🏦 Все счета</h3>
		</div>
		@if (isLoading)
		{
			<p>Загрузка счетов...</p>
		}
		@if (organizations.Any())
		{
			@foreach (var org in organizations)
			{
				<div class="organization-card">
					<h4>@org.Name</h4>
					<div class="account-list">
						@foreach (var account in org.Accounts)
						{
							<div class="account-item">
								<p><strong>Номер счета: </strong><span>@account.AccountNumber</span></p>
								<p><strong>Название: </strong><span>@account.Name</span></p>
								@* <p><strong>Тип счета: </strong>@account.AccountType</p> *@
								<p><strong>Банк: </strong><span>@account.BankName</span></p>
								<p><strong>Остаток: </strong><span>@account.CurrentBalance.ToString("C")</span></p>
								<button @onclick="@(() => ViewAccountDetails(account.Id))" class="btn-login btn-info">Подробнее</button>
							</div>
						}
					</div>
				</div>
			}
		}
		else
		{
			<div class="empty-state">
				<h4>📊 Счета не найдены</h4>
				<p>В системе пока нет зарегистрированных счетов</p>
			</div>
		}
	</body>
	</html>
	@if (showBankModal)
	{
		<BankManagementModal OnClose="CloseModals" />
	}
	@if (showOrganizationModal)
	{
		<OrganizationManagementModal OnClose="CloseModals" />
	}
	@if (showAccountModal)
	{
		<AccountManagementModal OnClose="CloseModals" />
	}
}


@code {
	private List<OrganizationOutputModel> organizations = new();
	private bool isLoading = true;
	private bool showBankModal = false;
	private bool showOrganizationModal = false;
	private bool showAccountModal = false;
	private bool isRedirecting = false;

	private bool isInitialized = false;
	private bool shouldRedirect = false;

	private void ShowBankModal() => showBankModal = true;
	private void ShowOrganizationModal() => showOrganizationModal = true;
	private void ShowAccountModal() => showAccountModal = true;

	private void CloseModals()
	{
		showBankModal = false;
		showOrganizationModal = false;
		showAccountModal = false;
		StateHasChanged();
	}

	protected override async Task OnInitializedAsync()
	{
		//await Task.Delay(500);
		////await AuthenticationService.InitializeAsync();
		// if (!AuthenticationService.IsAuthenticated)
		// {
		// 	//await Task.Delay(100);
		// 	Navigation.NavigateTo("/login");
		// 	return;
		// }
		AuthenticationService.OnAuthenticationStateChanged += StateHasChanged;
		//await LoadData();
		//isInitialized = true;
	}
	//
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			try
			{
				await AuthenticationService.InitializeAsync();
				if (!AuthenticationService.IsAuthenticated)
				{
					shouldRedirect = true;
					StateHasChanged();
				}
				else
				{
					await LoadData();
					isInitialized = true;
					StateHasChanged();
				}
			}
			catch (Exception ex)
			{
				Console.WriteLine($"Ошибка: {ex}");
			}
		}
	}
	//
	private async Task LoadData()
	{
		try
		{
			organizations = await LoadOrganizationsWithAccounts();
		}
		finally
		{
			isLoading = false;
		}
	}

	private async Task<List<OrganizationOutputModel>> LoadOrganizationsWithAccounts()
	{
		var accounts = await AccountService.GetAccountSummaryAsync();
		return accounts.GroupBy(a => a.OrganizationName).Select(g => new OrganizationOutputModel
			{
				Name = g.Key,
				Accounts = Mapper.Map<List<AccountDto>>(g.ToList())
			}).ToList();
	}

	private void ViewAccountDetails(int accountId)
	{
		
		try
		{
			Console.WriteLine($"Нажата кнопка для accountId: {accountId}");
			Navigation.NavigateTo($"/account/{accountId}");
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Ошибка навигации: {ex.Message}");
		}
	}

	private async Task Logout()
	{		
		if (isRedirecting) return;

		isRedirecting = true;
		//
		// try
		// {        
		// 	var userName = AuthenticationService.CurrentUser?.UserName ?? "Unknown";        
		// 	await AuthenticationService.LogoutAsync();        
		// 	await Task.Delay(100);        
		// 	Navigation.NavigateTo("/login", forceLoad: true);
		// }
		// catch (Exception ex)
		// {        
		// 	isRedirecting = false;
		// }
		//
		await AuthenticationService.LogoutAsync();
		
		Navigation.NavigateTo("/login");
	}

	// private void ShowBankModal()
	// {
	// 	showBankModal = true;		
	// }

	// private void ShowOrganizationModal()
	// {
	// 	showOrganizationModal = true;		
	// }

	// private void ShowAccountModal()
	// {
	// 	showAccountModal = true;		
	// }

	public void Dispose()
	{
		AuthenticationService.OnAuthenticationStateChanged -= StateHasChanged;
	}
}
