@page "/account/{AccountId:int}/upload"
@using BanksDB.Core.Dtos
@inject HttpClient Http

<h3>Загрузка транзакций</h3>


<InputFile OnChange="HandleFileSelected" />


@if (transactions != null && transactions.Any())
{
    <h4>Предпросмотр транзакций (всего @transactions.Count)</h4>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Дата</th>
                <th>Сумма</th>
                <th>Тип</th>
                <th>Описание</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in transactions)
            {
                <tr>
                    <td>@t.TransactionDate.ToShortDateString()</td>
                    <td>@t.Amount</td>
                    <td>@t.TransactionType</td>
                    <td>@t.Description</td>
                </tr>
            }
        </tbody>
    </table>

        <button class="btn btn-success" @onclick="ConfirmImport">Подтвердить импорт</button>
}


@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info mt-3">@message</div>
}

@code {
    [Parameter] public int AccountId { get; set; }
    private List<TransactionDto> transactions;

    // Уникальный идентификатор загрузки (uploadId),
    // возвращается от API после успешного предварительного разбора файла.
    private string uploadId;

    // Сообщение для пользователя (например, “Импорт успешно подтверждён”)
    private string message;

    // Обработчик выбора файла
    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;

        // Читаем файл в память (текстовое содержимое)
        using var reader = new StreamReader(file.OpenReadStream());
        var content = await reader.ReadToEndAsync();

        // Формируем объект запроса
        var request = new
        {
            AccountId = 1, // Для примера — можно выбрать счёт из выпадающего списка
            Content = content
        };

        // Отправляем запрос на API /api/import/preview
        var response = await Http.PostAsJsonAsync("/api/import/preview", request);

        if (response.IsSuccessStatusCode)
        {
            // Читаем результат (uploadId и количество строк)
            var result = await response.Content.ReadFromJsonAsync<PreviewResponse>();
            uploadId = result.UploadId;

            // Загружаем список транзакций по этому ID
            transactions = await Http.GetFromJsonAsync<List<TransactionDto>>($"/api/import/preview/{uploadId}");
        }
        else
        {
            message = "Ошибка при загрузке файла.";
        }
    }

    // Метод подтверждения импорта
    private async Task ConfirmImport()
    {
        if (string.IsNullOrEmpty(uploadId))
        {
            message = "Нет данных для подтверждения.";
            return;
        }

        var response = await Http.PostAsync($"/api/import/confirm/{uploadId}", null);
        if (response.IsSuccessStatusCode)
        {
            message = "Импорт успешно подтверждён!";
            transactions = null; // очищаем таблицу
        }
        else
        {
            message = "Ошибка при подтверждении импорта.";
        }
    }

    // DTO для результата превью
    private class PreviewResponse
    {
        public string UploadId { get; set; }
        public int Count { get; set; }
    }
}
