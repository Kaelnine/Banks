@page "/account/{Id:int}"
@using BanksDB.BLL.Interfaces
@using BanksDB.BLL.Services
@using BanksDB.Core.Models.OutputModels
@using BanksDB.Core.Models.InputModels
@using BanksDB.Core.Enums
@using BanksDB.BLL.Parsers
@using Microsoft.AspNetCore.Components.Forms
@inject ITransactionService TransactionService
@inject IAccountService AccountService
@inject NavigationManager Navigation
@inject AuthenticationService AuthenticationService
@inject IJSRuntime JSRuntime

<PageTitle>Информация по счету</PageTitle>
@* <head><link href="/css/account.css" rel="stylesheet"/></head> *@

@if (shouldRedirect)
{
    <div style="text-align: center; padding: 3rem;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Загрузка...</span>
        </div>
        <p class="mt-2">Перенаправление на страницу входа...</p>
    </div>
}
else if (!isInitialized)
{
    <div style="text-align: center; padding: 3rem;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Загрузка...</span>
        </div>
        <p class="mt-2">Инициализация...</p>
    </div>
}
else
{
<div class="account-details-container">    
        <div class="page-header">
        <div class="header-content">
            <button @onclick="GoBack" class="btn-back">
                ← Назад
            </button>
            <h3>📊 Детали счета</h3>
            <div class="header-actions">
                @if (AuthenticationService.HasAccessToEdit())
                {
                    <button @onclick="ShowUploadModal" class="btn-upload">
                        📁 Загрузить транзакции
                    </button>
                }
            </div>
        </div>
    </div>
    @if (accountInfo != null)
    {
        <div class="account-info-card">
            <div class="account-header">
                <h4>@accountInfo.Name</h4>
                <span class="account-number">@accountInfo.AccountNumber</span>
            </div>
            <div class="account-details">
                <div class="detail-row">
                    <span class="label">Организация:</span>
                    <span class="value">@accountInfo.OrganizationName</span>
                </div>
                <div class="detail-row">
                    <span class="label">Банк:</span>
                    <span class="value">@accountInfo.BankName (БИК: @accountInfo.BankBik)</span>
                </div>
                <div class="detail-row">
                    <span class="label">Текущий баланс:</span>
                    <span class="value balance @GetBalanceClass(accountInfo.CurrentBalance)">
                        @accountInfo.CurrentBalance.ToString("C")
                    </span>
                </div>
            </div>
        </div>
    }
    else if (!isLoading)
    {
        <div class="alert alert-warning">
            ❌ Не удалось загрузить информацию о счете ID: @Id
        </div>
    }
    <div class="filter-section">
        <h5>📅 Выбор периода</h5>
        <div class="filter-form">
            <div class="form-group">
                <label for="startDate">С:</label>
                <input type="date" @bind="dateRange.StartDate" @bind:format="yyyy-MM-dd"
                       class="form-control" id="startDate" />
            </div>
            <div class="form-group">
                <label for="endDate">По:</label>
                <input type="date" @bind="dateRange.EndDate" @bind:format="yyyy-MM-dd"
                       class="form-control" id="endDate" />
            </div>
            <button @onclick="LoadDailySummary" class="btn-apply" disabled="@isLoading">
                @if (isLoading)
                {
                    <span>Загрузка...</span>
                }
                else
                {
                    <span>Применить</span>
                }
            </button>
            <button @onclick="SetCurrentMonth" class="btn-secondary">
                Текущий месяц
            </button>
        </div>
    </div>

   
    <div class="summary-section">
        <h5>📈 Сводка по дням</h5>

        @if (isLoading)
        {
            <div class="loading-spinner">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Загрузка...</span>
                </div>
            </div>
        }
        else if (dailySummary.Any())
        {
            <div class="summary-table">
                <div class="table-header">
                    <div class="col-date">Дата</div>
                    <div class="col-income">Приход</div>
                    <div class="col-expense">Расход</div>
                    <div class="col-count">Операций</div>
                    <div class="col-actions">Действия</div>
                </div>

                @foreach (var day in dailySummary)
                {
                    <div class="table-row">
                        <div class="col-date">
                            <strong>@day.Date.ToString("dd.MM.yyyy")</strong>
                            <div class="day-name">@day.Date.ToString("dddd", new System.Globalization.CultureInfo("ru-RU"))</div>
                        </div>
                        <div class="col-income income-amount">
                            @day.TotalIncome.ToString("C")
                        </div>
                        <div class="col-expense expense-amount">
                            @day.TotalExpense.ToString("C")
                        </div>
                        <div class="col-count">
                            <span class="badge @GetTransactionCountClass(day.TransactionCount)">
                                @day.TransactionCount
                            </span>
                        </div>
                        <div class="col-actions">
                            <button @onclick="() => ViewDayTransactions(day.Date)"
                                    class="btn-details"
                                    disabled="@(day.TransactionCount == 0)">
                                Подробнее
                            </button>
                        </div>
                    </div>
                }
            </div>
            
            <div class="period-totals">
                <div class="total-card income-total">
                    <div class="total-label">Общий приход</div>
                    <div class="total-amount">@dailySummary.Sum(d => d.TotalIncome).ToString("C")</div>
                </div>
                <div class="total-card expense-total">
                    <div class="total-label">Общий расход</div>
                    <div class="total-amount">@dailySummary.Sum(d => d.TotalExpense).ToString("C")</div>
                </div>
                <div class="total-card net-total">
                    <div class="total-label">Итоговое изменение</div>
                    <div class="total-amount @GetBalanceClass(dailySummary.Sum(d => d.TotalIncome) - dailySummary.Sum(d => d.TotalExpense))">
                        @((dailySummary.Sum(d => d.TotalIncome) - dailySummary.Sum(d => d.TotalExpense)).ToString("C"))
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div>📊</div>
                <h6>Нет данных за выбранный период</h6>
                <p>Транзакции не найдены для указанного периода времени</p>
            </div>
        }
    </div>
</div>


@if (showUploadModal)
{
    <div class="modal-overlay">
        <div class="modal-content">
            <div class="modal-header">
                <h5>📁 Загрузка банковской выписки</h5>
                <button @onclick="CloseUploadModal" class="btn-close">&times;</button>
            </div>
            <div class="modal-body">
                <div class="upload-instructions">
                    <h6>Формат файла:</h6>
                    <p>Поддерживаются файлы выписок в формате TXT</p>
                    <p><strong>Требования:</strong></p>
                    <ul>
                        <li>Файл должен быть в кодировке Windows-1251</li>
                        <li>Формат: TXT</li>
                        <li>Должны содержаться секции "Платежное поручение"</li>
                    </ul>                    
                </div>   
                <div class="file-upload-section">
                    <InputFile OnChange="HandleFileSelected"
                               accept=".txt"
                               class="transparent-file-input">
                        <div class="file-upload-area">
                            <div class="upload-placeholder">
                                <div>📎</div>
                                <p>Нажмите для выбора файла выписки</p>
                                <small>Поддерживается только формат TXT</small>
                            </div>
                        </div>
                    </InputFile>
                </div>

                @if (!string.IsNullOrEmpty(uploadError))
                {
                    <div class="alert alert-danger">
                        @uploadError
                    </div>
                }
                
                @if (parserResult?.Transactions.Any() == true)
                {
                    <div class="parsed-transactions">                       
                        <h6>Найдено транзакций: @parserResult.TotalTransactionsFound</h6>
                        @if (duplicateCount > 0)
                        {
                                <div class="alert alert-warning">
                                    <i class="bi bi-exclamation-triangle"></i>
                                    Обнаружено дубликатов: @duplicateCount
                                    <br />
                                    <small>Будет загружено: @(parserResult.TotalTransactionsFound - duplicateCount) новых транзакций</small>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-success">
                                    <i class="bi bi-check-circle"></i>
                                    Дубликатов не обнаружено
                                </div>
                            }
                            <div class="transaction-preview">
                            @foreach (var transaction in parsedTransactions.Take(3))
                            {
                                var isDuplicate = duplicateTransactions.Contains(transaction);
                                <div class="preview-item @(isDuplicate ? "duplicate" : "")">
                                    <span>@transaction.TransactionDate.ToString("dd.MM.yyyy")</span>
                                    <span class="@(transaction.TransactionType == "Приход" ? "income" : "expense")">
                                        @transaction.TransactionType
                                        @if (isDuplicate)
                                        {
                                            <span class="duplicate-label">(дубликат)</span>
                                        }
                                    </span>
                                    <span>@transaction.Amount.ToString("C")</span>
                                 <div class="preview-description">
                                    @transaction.Description
                                </div>
                                <div class="preview-counterparty">
                                    Контрагент: @(transaction.CounterpartyName ?? transaction.PayerName ?? "Не указан")
                                </div>
                                @if (isDuplicate)
                                {
                                    <div class="duplicate-warning">
                                        ⚠️ Эта транзакция уже существует в системе
                                    </div>
                                }
                                </div>
                            }
                            @if (parsedTransactions.Count > 5)
                            {
                                <div class="preview-more">
                                    ... и еще @(parsedTransactions.Count - 5) транзакций
                                </div>
                            }
                        </div>
                    </div>
                }
                @if (parserResult?.Errors.Any() == true)
                {
                    <div class="alert alert-warning">
                        <h6>Предупреждения:</h6>
                        <ul>
                            @foreach (var error in parserResult.Errors.Take(3))
                            {
                                <li>@error</li>
                            }
                        </ul>
                        @if (parserResult.Errors.Count > 3)
                        {
                            <small>... и еще @(parserResult.Errors.Count - 3) предупреждений</small>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button @onclick="CloseUploadModal" class="btn btn-secondary">
                    Отмена
                </button>
                <button @onclick="UploadTransactions" class="btn btn-success"                        
                        disabled="@(parserResult?.Transactions.Any() != true || isUploading)">
                    @if (isUploading)
                    {
                        <span>Загрузка...</span>
                    }
                    else
                    {                        
                        <span>📤 Загрузить (@parserResult?.TotalTransactionsFound)</span>
                    }
                </button>
            </div>
        </div>
    </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private AccountOutputModel? accountInfo;
    private List<DailySummaryOutputModel> dailySummary = new();
    private DateRangeInputModel dateRange = new();
    private bool isLoading = false;
    private bool showUploadModal = false;
    private bool isUploading = false;
    private string uploadError = string.Empty;
    private List<TransactionInputModel> parsedTransactions = new();    
    private InputFile? fileInput;
    private BankParserResult parserResult;
    private ElementReference fileInputElement;
    private int duplicateCount = 0;
    private List<TransactionInputModel> duplicateTransactions = new();
    private List<TransactionInputModel> uniqueTransactions = new();

    private bool isInitialized = false;
	private bool shouldRedirect = false;

    protected override void OnInitialized()
    {
        AuthenticationService.OnAuthenticationStateChanged += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await AuthenticationService.InitializeAsync();
                if (!AuthenticationService.IsAuthenticated)
                {
                    shouldRedirect = true;
                    StateHasChanged();
                    return;
                }
                else
                {
                    await LoadAccountInfo();
                    SetCurrentMonth();
                    await LoadDailySummary();
                    isInitialized = true;
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Ошибка инициализации: {ex}");
            }
        }
    }
    private async Task HandleInputFileSelected(InputFileChangeEventArgs e)
    {
        uploadError = string.Empty;
        parserResult = null;
        duplicateCount = 0;
        duplicateTransactions.Clear();
        uniqueTransactions.Clear();

        var file = e.File;
        if (file == null) return;

        if (Path.GetExtension(file.Name).ToLower() != ".txt")
        {
            uploadError = "Поддерживаются только файлы в формате TXT";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            parserResult = await TransactionService.BankParserStatementAsync(stream, Id);
            if (parserResult?.Transactions.Any() == true)
            {                
                duplicateCount = await TransactionService.GetDuplicateCountAsync(parserResult.Transactions);
                uniqueTransactions = await TransactionService.FilterDuplicateTransactionsAsync(parserResult.Transactions);               
                foreach (var transaction in parserResult.Transactions)
                {
                    if (await TransactionService.IsDuplicateTransactionAsync(transaction))
                    {
                        duplicateTransactions.Add(transaction);
                    }
                }
            }
            if (!parserResult.IsValid && parserResult.Errors.Any())
            {
                uploadError = string.Join("; ", parserResult.Errors.Take(3));
            }
        }
        catch (Exception ex)
        {
            uploadError = $"Ошибка чтения файла: {ex.Message}";
        }

        StateHasChanged();
    }
    private async Task TriggerFileInput()
    {
        if (fileInput != null)
        {
            await JSRuntime.InvokeVoidAsync("clickFileInput", fileInput.Element);
        }
    }

    // protected override async Task OnInitializedAsync()
    // {        
    //     await LoadAccountInfo();
    //     SetCurrentMonth();   
    //     await LoadDailySummary();
    // }

    protected override async Task OnParametersSetAsync()
    {
        // if (Id > 0)
        // {
        //     dateRange.AccountId = Id;
        //     await LoadAccountInfo();
        // }
        if (Id > 0 && AuthenticationService.IsAuthenticated)
        {
            dateRange.AccountId = Id;
            if (isInitialized)
            {
                await LoadAccountInfo();
            }
        }
    }

    private async Task LoadAccountInfo()
    {
        try
        {
            accountInfo = await AccountService.GetByIdAsync(Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки информации о счете: {ex.Message}");
        }
    }

    private async Task LoadDailySummary()
    {
        if (!AuthenticationService.IsAuthenticated) return;
        isLoading = true;
        StateHasChanged();

        try
        {
            dailySummary = await TransactionService.GetDailySummaryAsync(
                Id,
                dateRange.StartDate,
                dateRange.EndDate
            );
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки сводки: {ex.Message}");
            dailySummary = new List<DailySummaryOutputModel>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void SetCurrentMonth()
    {
        var today = DateTime.Now;
        dateRange.StartDate = new DateTime(today.Year, today.Month, 1);
        dateRange.EndDate = today;
    }

    private void ViewDayTransactions(DateTime date)
    {
        Navigation.NavigateTo($"/transactions/{Id}/{date:yyyy-MM-dd}");
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/index");
    }

    private void ShowUploadModal()
    {
        showUploadModal = true;
        uploadError = string.Empty;
        parsedTransactions.Clear();        
    }

    private void CloseUploadModal()
    {
        showUploadModal = false;        
        uploadError = string.Empty;        
        parserResult = null;
        isUploading = false;
    }    

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        uploadError = string.Empty;        
        parserResult = null;

        var file = e.File;
        if (file == null) return;

        if (Path.GetExtension(file.Name).ToLower() != ".txt")
        {
            uploadError = "Поддерживаются только файлы в формате TXT";
            return;
        }

        try
        {            
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            parserResult = await TransactionService.BankParserStatementAsync(stream, Id);
            if (!parserResult.IsValid && parserResult.Errors.Any())
            {
                uploadError = string.Join("; ", parserResult.Errors.Take(3));
            }
        }
        catch (Exception ex)
        {
            uploadError = $"Ошибка чтения файла: {ex.Message}";
        }
        StateHasChanged();
    }

    private async Task UploadTransactions()
    {        
        if (parserResult?.Transactions.Any() != true)
        {
            return;
        }
        isUploading = true;
        StateHasChanged();

        try
        {            
            var importedTransactions = await TransactionService.ImportTransactionsAsync(parserResult.Transactions);
            var message = $"✅ Успешно загружено {importedTransactions.Count} транзакций";
            if (duplicateCount > 0)
            {
                message += $"\n⚠️ Пропущено {duplicateCount} дубликатов";
            }
            await JSRuntime.InvokeVoidAsync("alert", message);
            // await JSRuntime.InvokeVoidAsync("alert", $"✅ Успешно загружено {importedTransactions.Count} транзакций");            
            await LoadDailySummary();
            CloseUploadModal();
        }
        catch (Exception ex)
        {
            uploadError = $"Ошибка загрузки: {ex.Message}";
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    private string GetBalanceClass(decimal balance)
    {
        return balance >= 0 ? "positive" : "negative";
    }

    private string GetTransactionCountClass(int count)
    {
        return count == 0 ? "badge-secondary" : "badge-primary";
    }    
}
